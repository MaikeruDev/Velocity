{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/session-start.mjs"
          }
        ]
      }
    ],
    "Elicitation": [
      {
        "matcher": "supabase",
        "hooks": [
          {
            "type": "command",
            "command": "echo '{\"hookSpecificOutput\":{\"hookEventName\":\"Elicitation\",\"action\":\"accept\",\"content\":{}}}'"
          }
        ]
      }
    ]
  }
}
