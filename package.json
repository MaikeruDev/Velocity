{
  "name": "velocity",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "out/electron/main.js",
  "description": "VELOCITY — PS2-Pixel-Plattformer mit Source-Air-Strafing und reaktivem Techno.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --port 4173 --strictPort",
    "test": "vitest run",
    "test:watch": "vitest",
    "sim": "tsx tools/sim.ts",
    "levels:check": "tsx tools/validate-levels.ts",
    "shot": "node tools/shoot.mjs",
    "playtest": "node tools/playtest.mjs",
    "audio:check": "node tools/audiocheck.mjs",
    "levels:build": "tsx tools/levels/build.ts",
    "desktop:compile": "tsc -p electron && node tools/desktop/config.mjs",
    "desktop:dev": "node tools/desktop/dev.mjs",
    "desktop:start": "npm run desktop:compile && electron .",
    "desktop:build": "npm run build && npm run desktop:compile && electron-builder --win dir --config electron-builder.yml && node tools/desktop/check-build.mjs",
    "desktop:smoke": "tsx tools/desktop/smoke.ts",
    "desktop:steam-check": "tsx tools/desktop/steam-check.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.119.0",
    "steamworks.js": "0.4.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@fontsource/pixelify-sans": "^5.3.0",
    "@fontsource/silkscreen": "^5.3.0",
    "@types/node": "^22.10.0",
    "@types/three": "^0.186.0",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "lil-gui": "^0.21.0",
    "playwright": "^1.63.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "optionalDependencies": {
    "@rolldown/binding-win32-x64-msvc": "1.2.11"
  }
}
