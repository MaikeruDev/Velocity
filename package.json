{
  "name": "velocity",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "VELOCITY — PS2-Pixel-Plattformer mit Source-Air-Strafing und reaktivem Techno.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --port 4173 --strictPort",
    "test": "vitest run",
    "test:watch": "vitest",
    "sim": "tsx tools/sim.ts",
    "levels:check": "tsx tools/validate-levels.ts",
    "shot": "node tools/shoot.mjs",
    "playtest": "node tools/playtest.mjs",
    "audio:check": "node tools/audiocheck.mjs",
    "levels:build": "tsx tools/levels/build.ts"
  },
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@fontsource/pixelify-sans": "^5.3.0",
    "@fontsource/silkscreen": "^5.3.0",
    "@types/node": "^22.10.0",
    "@types/three": "^0.186.0",
    "lil-gui": "^0.21.0",
    "playwright": "^1.63.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "optionalDependencies": {
    "@rolldown/binding-win32-x64-msvc": "1.2.11"
  }
}
